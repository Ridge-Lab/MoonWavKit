// To add a dependency, run this command in your terminal:
//   moon add moonbitlang/x
//
// Or manually declare it in `import`, for example:
// import {
//   "moonbitlang/x@0.4.6",
// }

name = "Ridge-Lab/moonwavkit"

version = "0.1.1"

readme = "README.md"

repository = "https://github.com/Ridge-Lab/MoonWavKit.git"

license = "MIT"

keywords = [ "wav", "audio", "pcm", "riff", "moonbit" ]

preferred_target = "wasm-gc"

description = "MoonBit-native WAV parser, PCM decoder, waveform analysis, validation, and audio utility toolkit."
